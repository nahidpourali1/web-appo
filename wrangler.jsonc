{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appo",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b7415200-5a9f-44db-a63c-3cc566795d9b","database_name": "web-appo" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6c2c278357464abfb33d616f6be20e22" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
